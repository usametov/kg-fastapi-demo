# Local development only (Twelve-Factor III). In Docker/Kubernetes set these as
# real environment variables / Secrets; never commit a real .env.

ENVIRONMENT=dev
PORT=8000
LOG_LEVEL=INFO

# --- Neo4j (attached resource) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# --- LLM (attached resource; any LiteLLM model string) ---
LLM_MODEL=openai/gpt-4o
OPENAI_API_KEY=sk-your-key-here
# LLM_API_BASE=http://localhost:11434   # e.g. Ollama
EXTRACTION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

# --- Files the agents can see (Neo4j must see the same files in its import dir) ---
DATA_DIR=data

# --- State / concurrency ---
STATE_BACKEND=memory          # memory | redis
REDIS_URL=redis://localhost:6379/0
STATE_TTL_SECONDS=86400
JOB_RUNNER=inprocess          # inprocess | worker (worker needs STATE_BACKEND=redis)

# --- Agent knobs (from the notebooks) ---
SCHEMA_LOOP_MAX_ITERATIONS=2
REVIEW_CHUNK_SEPARATOR=---
ENTITY_SIMILARITY_THRESHOLD=0.1
